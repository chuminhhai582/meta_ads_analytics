# =====================================================================
# CẤU HÌNH KẾT NỐI META MARKETING API & MCP SERVER
# Xem chi tiết cách lấy token tại file: HUONG_DAN_LAY_TOKEN_META.md
# =====================================================================

# 1. Meta User Access Token hoặc System User Access Token
# Bắt buộc cần có các quyền: ads_read, read_insights (hoặc ads_management nếu muốn tạo/sửa quảng cáo)
# LƯU Ý: token người dùng thường hết hạn sau ~60 ngày. Nếu Đồng bộ báo lỗi
# "Session has expired", vào lại trình quản lý ứng dụng Meta lấy token mới.
META_ADS_ACCESS_TOKEN=your_meta_access_token_here

# 2. Ad Account ID (Mã tài khoản quảng cáo)
# Chỉ nhập phần SỐ, KHÔNG kèm tiền tố "act_" (ví dụ act_123456789 thì nhập 123456789)
META_AD_ACCOUNT_ID=your_ad_account_id_here

# 3. Business Manager ID — phạm vi duy nhất được phép lấy dữ liệu (quy tắc dự án §1)
META_BUSINESS_ID=2590933284556026

# 4. Phiên bản Graph API của Meta (mặc định v21.0 hoặc v22.0)
META_API_VERSION=v21.0

# 5. App ID / App Secret (tuỳ chọn — chỉ cần nếu muốn tự gia hạn token)
META_APP_ID=
META_APP_SECRET=

# 6. Cổng chạy Web Dashboard phân tích nội bộ (mặc định 3000)
PORT=3000

# 7. Mở dashboard ra mạng LAN? Mặc định KHÔNG.
# Dashboard hiển thị chi tiêu, doanh thu và số điện thoại phụ huynh, nên chỉ nhận
# kết nối từ chính máy cài đặt. Chỉ đặt thành true nếu bạn thực sự muốn người khác
# trong mạng nội bộ xem được.
ALLOW_REMOTE=false

# 8. Đường link Google Sheet CRM (Xuất bản web định dạng CSV)
# Sheet phải có cột "Ad ID" chứa ID QUẢNG CÁO (ad id) để ghép lead vào chiến dịch.
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv
